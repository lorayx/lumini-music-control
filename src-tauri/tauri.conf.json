{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LUMINI Music Control",
  "version": "0.12.0",
  "identifier": "io.lumini.musiccontrol",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "LUMINI Music Control",
        "width": 440,
        "height": 430,
        "resizable": false,
        "minimizable": false,
        "maximizable": false,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "shadow": false
      },
      {
        "label": "taskbar",
        "title": "LUMINI Taskbar",
        "url": "index.html?view=taskbar",
        "width": 272,
        "height": 40,
        "resizable": false,
        "minimizable": false,
        "maximizable": false,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "shadow": false,
        "focus": false,
        "focusable": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "shortDescription": "Управление Яндекс Музыкой из системного трея",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Russian",
          "English"
        ],
        "displayLanguageSelector": false
      }
    }
  }
}
